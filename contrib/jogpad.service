# Example systemd unit. Adjust User and the paths, then:
#   sudo cp contrib/jogpad.service /etc/systemd/system/
#   sudo systemctl enable --now jogpad
[Unit]
Description=jogpad jog pendant
Documentation=https://github.com/Aitch-ko/jogpad
After=moonraker.service

[Service]
Type=simple
User=pi
# The user needs the group "input" to read the pad.
ExecStart=/home/pi/jogpad/.venv/bin/jogpad serve --config /home/pi/printer_data/config/jogpad.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
